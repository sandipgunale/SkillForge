# ==========================================================
# SkillForge Backend — Environment Template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ==========================================================

# ---------- Database (PostgreSQL) ----------
DB_URL=jdbc:postgresql://localhost:5432/skillforge
DB_USERNAME=postgres
DB_PASSWORD=change-me

# ---------- JWT ----------
# HS256 signing key. MUST decode to at least 32 bytes (256 bits) — the app
# refuses to start with a shorter or missing secret.
# Generate one with: openssl rand -base64 64
JWT_SECRET=change-me-64-byte-base64-secret

# ---------- AI APIs ----------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODELS=gemini-flash-latest,gemini-2.5-flash,gemini-2.0-flash
# Per-user daily AI question budget (cost guardrail)
GEMINI_MAX_QUESTIONS_PER_DAY=200
OPENAI_API_KEY=your-openai-api-key

# ---------- Optional hardening ----------
# Set to true behind HTTPS so the auth cookie is Secure
COOKIE_SECURE=false
COOKIE_SAME_SITE=LAX

# Disable auth rate limiting only for local development
RATE_LIMIT_ENABLED=true

# ---------- App ----------
# Origin used in password-reset links sent by email
FRONTEND_URL=http://localhost:5173

# ---------- Bootstrap admin (optional) ----------
# Seeds an ADMIN account on startup (idempotent). Unset = no seeding.
ADMIN_EMAIL=admin@skillforge.com
ADMIN_PASSWORD=

# ---------- SMTP (optional) ----------
# Leave SMTP_HOST empty in development: reset links are logged instead of emailed
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
